# Azure CLI is intentionally absent: runtime authentication uses managed identity.
FROM ghcr.io/astral-sh/uv:0.9.30 AS uv
FROM python:3.12-slim AS base

FROM base AS builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY apps/agent/pyproject.toml apps/agent/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --python /usr/local/bin/python3.12

FROM base AS runner
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN groupadd --gid 1001 agent && useradd --uid 1001 --gid agent --create-home agent
COPY --from=builder --chown=agent:agent /app/.venv /app/.venv
COPY --chown=agent:agent apps/agent/main.py ./
COPY --chown=agent:agent apps/agent/src ./src
COPY --chown=agent:agent apps/agent/skills ./skills
USER agent
EXPOSE 8123
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8123"]
