# Agent settings: place these in apps/agent/.env.
# Azure AI Foundry with Entra ID authentication (default local mode; no API key required for Foundry):
AZURE_AI_FOUNDRY_ENABLED=true
AZURE_AI_FOUNDRY_ENDPOINT=https://ai-isarar-2855.services.ai.azure.com
AZURE_SUBSCRIPTION_ID=79e1d757-ecdb-4dc3-b0b4-035bac76053d
AZURE_TENANT_ID=ddcbdc96-6162-4d91-bb0d-066343049ce1
LLM_MODEL=gpt-6-luna
# Optional shared model: deepseek-v4.1-flash (deployment FW-DeepSeek-V4.1-Flash).
# Requires Foundry/Entra; also accepts the exact deployment name in LLM_MODEL.
# DeepSeek uses Chat Completions with low/medium/high effort (default medium).
# LLM_REASONING_EFFORT=medium
AZURE_DECISION_DEPLOYMENT=Decision-1

# Microsoft Web IQ public internet grounding (/v3/search/web):
WEBIQ_API_KEY=
WEBIQ_ENDPOINT=https://api.microsoft.ai/v3/search/web

# Optional direct provider API keys (when AZURE_AI_FOUNDRY_ENABLED=false or using claude-*):
# Never expose keys to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# MCP_SERVER_URL=http://localhost:3100/mcp

# Telemetry (docs/telemetry.md): anonymous install counts, on by default.
# Set either to turn it off.
# DO_NOT_TRACK=1
# COPILOTKIT_TELEMETRY_DISABLED=1
# OIUI_DISTRIBUTION=self_hosted
# Optional browser page analytics; leave unset unless you want them.
# NEXT_PUBLIC_POSTHOG_KEY=

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
